# כתובת חיבור למסד הנתונים PostgreSQL
# פיתוח מקומי (אם משתמשים ב-docker-compose.yml המצורף):
DATABASE_URL="postgresql://gemach:gemach@localhost:5433/gemach?schema=public"

# פורט השרת
PORT=4000

# סוד להצפנת JWT - ערך אקראי וסודי בפרודקשן, לא לשתף
JWT_SECRET="change-this-to-a-long-random-secret-in-production"

# תוקף הטוקן
JWT_EXPIRES_IN="7d"

# כתובות שמורשות לגשת לשרת (CORS), מופרדות בפסיק
CORS_ORIGIN="http://localhost:5175"

# פרטי מנהלת שנוצרת ב-Seed (רק פיתוח/הרצת seed ראשונית)
ADMIN_EMAIL="admin@gemach.local"
ADMIN_PASSWORD="Admin123!"
ADMIN_FULL_NAME="מנהלת המערכת"
ADMIN_PHONE="050-0000000"
ADMIN_NEIGHBORHOOD="מרכז העיר"

# הפעלת seed לנתוני דמו בעלייה הראשונה בפרודקשן (רק אם true, ורק אם המסד ריק מנתוני דמו)
SEED_DEMO="false"

# סיסמה משותפת למשתמשות הדמו שנוצרות ע"י seed:demo (אם המשתנה חסר - לא נוצרות משתמשות דמו בכלל)
DEMO_USERS_PASSWORD=""
